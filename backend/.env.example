# Copy to .env and adjust.

# REQUIRED outside local dev: a long random string.
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173
# Saved calls (SQLite). Empty = keep calls in memory only.
DB_PATH=data/voicebridge.db

# Speech-to-text: sherpa (local Parakeet, English, free; default here) | deepgram (cloud, paid) | whisper (local
# faster-whisper, English + Hindi) | mock (no model, for UI dev). Models for sherpa: python scripts/download_models.py
STT_PROVIDER=sherpa
# deepgram only: local engine used when Deepgram is unreachable (bad key, no credit, no internet) or no key is set.
STT_FALLBACK=sherpa

# sherpa-onnx (local, CPU). Files under SHERPA_MODEL_DIR, fetched by scripts/download_models.py.
SHERPA_MODEL_DIR=models
SHERPA_ASR_MODEL=sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
# Threads per transcription; STT_CONCURRENCY transcriptions run at once (both speakers, live text and finals).
SHERPA_NUM_THREADS=2
STT_CONCURRENCY=4
# In-room live: voice-print similarity (0-1) at which a line joins a known voice. Higher = more speakers.
SHERPA_SPEAKER_THRESHOLD=0.5

# Deepgram: paste your key from https://console.deepgram.com (API Keys). Keep it secret.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# multi = English + Hindi in the same sentence (Hinglish). en = English only (cheaper).
DEEPGRAM_LANGUAGE=en
# Silence (ms) that ends a sentence.
DEEPGRAM_ENDPOINTING_MS=300

# Whisper language: ISO code (en, hi...). Empty = auto-detect per sentence (needed for Hindi).
STT_LANGUAGE=

# Gemini API key (Google AI Studio), used for call analysis below.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Call analysis after each call: summary, sentiment and masking of sensitive values.
# Provider order: Gemini if GEMINI_API_KEY is set (above; GEMINI_MODEL picks the model), then Anthropic if
# ANTHROPIC_API_KEY is set, else the local model through Ollama (free, no key, CPU only). If one fails, the
# next is tried. To switch to a cloud model, just set its key.
CALL_ANALYSIS=true
# Mask long numbers (card, phone, account) and emails as each line is finalised. Names are never masked.
PII_MASKING=true
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Local model (https://ollama.com; install, then: ollama pull qwen2.5:7b)
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# How long Ollama keeps the model loaded (its default is 5m); unloading drops the cached hint prompt.
OLLAMA_KEEP_ALIVE=60m
LLM_CPU_ONLY=true

# Whisper (local). Model downloads once on first start. small = multilingual (English + Hindi);
# small.en is more accurate for English only.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# CPU: parallel workers x threads each. 1 thread per worker was fastest in testing.
WHISPER_NUM_WORKERS=2
WHISPER_CPU_THREADS=1
# With an NVIDIA GPU: WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16, WHISPER_MODEL=small or larger

# Voice activity detection: sherpa (Silero model through sherpa-onnx, no torch) | energy (loudness) | silero (torch)
VAD_PROVIDER=sherpa
VAD_ENERGY_THRESHOLD_DBFS=-45
END_SILENCE_MS=2000
MAX_UTTERANCE_MS=15000
PARTIALS_ENABLED=true
PARTIAL_INTERVAL_MS=1500
# sherpa: live text reads at most this much new audio of a line (0 rereads the whole line each time);
# the last PARTIAL_KEEP_MS of it stays open to correction. The saved line is always read in full.
PARTIAL_WINDOW_MS=2000
PARTIAL_KEEP_MS=800

# Live hints (next best action) during a call: a hint after each line from the other person, plus the facts
# they gave. Local model only (Ollama, CPU), free; nothing leaves the PC. Install: ollama pull qwen2.5:7b
# (A smaller model such as qwen2.5:3b should be faster but was not measured: ollama pull qwen2.5:3b, then NBA_MODEL=qwen2.5:3b.)
NBA_ENABLED=true
# Hints on when a call starts (each call has a Hints on/off switch in the Assist panel; the browser remembers
# the user's choice). Off saves most of the model's work: hints are ~87% of its tokens.
NBA_DEFAULT_ON=true
NBA_MODEL=qwen2.5:7b
# Context for hints. Empty = same as the summary's (LLM_NUM_CTX, 16384): keep them equal. Two sizes of one model make
# Ollama reload it on every switch, and Ollama 0.40.4 hung the summary forever while hints held the other size.
NBA_NUM_CTX=
# Seconds before a hint turn is dropped; includes waiting behind a warm-up (~20 s on CPU).
NBA_TIMEOUT_S=60

# Jira tickets from the call: say "create a Jira ticket ..." on a call; the Assist panel drafts a ticket and
# creates it when you click Create. On only when the four values below are set.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens (keep it secret).
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SCRUM
# JIRA_ISSUE_TYPE=Task
# Create each drafted ticket at once, without the Create click.
JIRA_AUTO_CREATE=false

# Slack recap: when a call's summary is ready it is posted to this channel as you (and edited, not posted again,
# when the summary changes). On only when SLACK_USER_TOKEN and SLACK_RECAP_CHANNEL are set. Tokens: your Slack
# app at https://api.slack.com/apps > OAuth & Permissions (keep them secret).
# User OAuth Token (user scope chat:write): recaps show your name and photo.
# SLACK_USER_TOKEN=xoxp-...
# Bot User OAuth Token (bot scope users:read), optional: names in the recap become @mentions.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_RECAP_CHANNEL=voicebridge-recaps
